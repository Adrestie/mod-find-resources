#
# mod-find-resources configuration
#

[worldserver]

########################################
# Find Resources
########################################
#
#    FindResources.Enable
#        Description: Teach the spell Find Resources to the characters who
#                     gather, and take it back from those who no longer do.
#        Default:     1 - Enabled
#                     0 - Disabled: the module teaches and takes back nothing;
#                         the spell stays with whoever has it
#

FindResources.Enable = 1

#
#    FindResources.Professions
#        Description: How many of the three gathering skills (Herbalism,
#                     Mining, Fishing) a character needs to have the spell.
#        Range:       0 (every character) to 3
#        Default:     1
#

FindResources.Professions = 1
